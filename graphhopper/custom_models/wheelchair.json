{
  "distance_influence": 70,
  "priority": [
    {
      "if": "smoothness == IMPASSABLE",
      "multiply_by": "0"
    },
    {
      "if": "average_slope > 8",
      "multiply_by": "0"
    },
    {
      "if": "surface == SAND || surface == OTHER",
      "multiply_by": "0"
    },
    {
      "if": "footway == SIDEWALK",
      "multiply_by": "1.3"
    },
    {
      "if": "footway == CROSSING",
      "multiply_by": "1.1"
    },
    {
      "if": "crossing == TRAFFIC_SIGNALS || crossing == MARKED",
      "multiply_by": "1.2"
    },
    {
      "if": "average_slope > 5",
      "multiply_by": "0.3"
    },
    {
      "if": "surface == COBBLESTONE",
      "multiply_by": "0.3"
    },
    {
      "if": "surface == GRAVEL || surface == FINE_GRAVEL || surface == UNPAVED || surface == COMPACTED || surface == DIRT || surface == GROUND",
      "multiply_by": "0.5"
    },
    {
      "if": "smoothness == INTERMEDIATE",
      "multiply_by": "0.9"
    },
    {
      "if": "smoothness == BAD",
      "multiply_by": "0.5"
    },
    {
      "if": "smoothness == VERY_BAD || smoothness == HORRIBLE || smoothness == VERY_HORRIBLE",
      "multiply_by": "0.05"
    }
  ],
  "speed": [
    {
      "if": "average_slope > 3",
      "multiply_by": "0.8"
    },
    {
      "if": "average_slope > 5",
      "multiply_by": "0.6"
    },
    {
      "if": "surface == COBBLESTONE || surface == PAVING_STONES",
      "multiply_by": "0.7"
    },
    {
      "if": "smoothness == BAD || smoothness == VERY_BAD || smoothness == HORRIBLE",
      "multiply_by": "0.6"
    }
  ]
}
