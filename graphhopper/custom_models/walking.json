{
	"distance_influence": 60,
	"priority": [
		{
			"if": "footway == SIDEWALK",
			"multiply_by": "1.2"
		},
		{
			"if": "footway == CROSSING",
			"multiply_by": "1.1"
		},
		{
			"if": "crossing == TRAFFIC_SIGNALS || crossing == MARKED",
			"multiply_by": "1.2"
		},
		{
			"if": "road_class == FOOTWAY || road_class == PEDESTRIAN",
			"multiply_by": "1.3"
		},
		{
			"if": "road_class == PATH",
			"multiply_by": "1.15"
		},
		{
			"if": "road_class == PRIMARY || road_class == SECONDARY",
			"multiply_by": "0.8"
		},
		{
			"if": "road_class == TRUNK || road_class == MOTORWAY",
			"multiply_by": "0.3"
		},
		{
			"if": "surface == PAVED || surface == ASPHALT || surface == CONCRETE",
			"multiply_by": "1.1"
		},
		{
			"if": "surface == GRAVEL",
			"multiply_by": "0.9"
		},
		{
			"if": "max_width >= 2.0",
			"multiply_by": "1.2"
		},
		{
			"if": "max_width < 1.0",
			"multiply_by": "0.8"
		},
		{
			"if": "smoothness == IMPASSABLE",
			"multiply_by": "0"
		}
	],
	"speed": [
		{
			"if": "true",
			"limit_to": "5.0"
		},
		{
			"if": "road_class == STEPS",
			"multiply_by": "0.6"
		},
		{
			"if": "average_slope > 8",
			"multiply_by": "0.8"
		},
		{
			"if": "average_slope > 12",
			"multiply_by": "0.6"
		},
		{
			"if": "surface == GRAVEL",
			"multiply_by": "0.85"
		},
		{
			"if": "surface == UNPAVED || surface == DIRT",
			"multiply_by": "0.7"
		}
	]
}
